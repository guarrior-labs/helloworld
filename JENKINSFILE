pipeline {
    agent none

    stages {

        stage('Get Code') {
            agent any
            steps {
                //Limpia WorSpace antes de clonar.
                deleteDir()
                
                // Obtener el código fuente desde GitHub
                git 'https://github.com/guarrior-labs/helloworld.git'
                
                stash name: 'source-code', includes: '**/*'
            }
        }

        stage('Build') {
            agent any
            steps {
                // Python es interpretado, por lo que no requiere compilación
                echo 'Eyyy, esto es Python, no hay que compilar nada!!!'

                // Mostrar la ruta del workspace asignado por Jenkins
                echo "${env.WORKSPACE}"

                // Listar los archivos descargados en el workspace
                bat 'dir'
            }
        }

        stage('Tests') {

            // Ejecutar pruebas en paralelo para reducir tiempos
            parallel {
    
                stage('Unit') {
                    agent { label 'Nodo1'}
                    steps {
                        unstash 'source-code'

                        // Ejecutar pruebas unitarias
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {

                            bat '''
                                REM Agregar el workspace al PYTHONPATH
                                set "PYTHONPATH=%WORKSPACE%"

                                REM Instalar pytest si no existe
                                python -m pip install pytest

                                REM Ejecutar pruebas unitarias y generar reporte JUnit XML
                                python -m pytest --junitxml=result-unit.xml test/unit
                            '''
                        }
                        stash name:'result-unit', includes:'result-unit.xml'
                    }
                }

                stage('Rest') {
                    agent { label 'Nodo2'}
                    steps {
                        unstash 'source-code'
                        
                        // Ejecutar pruebas de integración / REST
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {

                            bat '''
                                REM Definir el archivo principal de Flask
                                set FLASK_APP=app\\api.py

                                REM Configurar Flask en modo desarrollo
                                set FLASK_ENV=development

                                REM Levantar la API Flask en segundo plano
                                start "" cmd /c flask run

                                REM Levantar WireMock para simular servicios externos
                                start "" cmd /c java -jar C:\\Users\\Guarr1or\\Downloads\\Programas\\DevOps\\WireMock\\wiremock-standalone-3.13.2.jar --port 9090 --root-dir test\\wiremock

                                
                                REM Esperar unos segundos para que los servicios arranquen
                                ping 127.0.0.1 -n 11 > nul

                                REM Agregar el workspace al PYTHONPATH
                                set "PYTHONPATH=%WORKSPACE%"

                                REM Instalar pytest si no existe
                                python -m pip install pytest

                                REM Ejecutar pruebas REST y generar reporte JUnit XML
                                python -m pytest --junitxml=result-rest.xml test\\rest
                            '''
                        }
                        stash name:'result-rest', includes:'result-rest.xml'
                    }
                }
            }
        }

        stage('Results') {
            agent any
            steps {

                // Publicar en Jenkins los resultados generados por pytest
                unstash name:'result-unit'
                unstash name:'result-rest'
                junit 'result*.xml'
            }
        }
    }
}
