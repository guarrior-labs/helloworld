pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                //obtener codigo del repositorio
                git 'https://github.com/guarrior-labs/helloworld.git'
            }
        }
        
        stage('Build') {
            steps {
                //Compilación de Código 
                echo 'Eyyy, esto es Python, no hay que compilar nada!!!'
                echo WORKSPACE
                bat 'dir'
            }
        }
        
        stage('Tests') {
            parallel {
        
                stage('Unit') {
                    steps {
                        //Pruebas Unitarias
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                set "PYTHONPATH=%WORKSPACE%"
                                python -m pip install pytest
                                python -m pytest --junitxml=result-unit.xml test/unit
                                '''
                        }
                    }
                }
                stage('Rest') {
                    steps {
                        //Microservicios
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                set FLASK_APP=app\\api.py
                                set FLASK_ENV=development

                                flask run
                                java -jar C:\\Users\\Guarr1or\\Downloads\\Programas\\DevOps\\WireMock\\wiremock-standalone-3.13.2.jar --port 9090 --root-dir test\\wiremock
                                set "PYTHONPATH=%WORKSPACE%"
                                python -m pip install pytest
                                python -m pytest --junitxml=result-rest.xml test\\rest
                            '''
                        }
                    }
                }
            }
        }    
        
        stage('Results') {
            steps {
                //Resultados de Pruebas
                junit 'result*.xml'
            }
        }        
    }
}
